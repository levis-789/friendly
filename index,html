<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ระบบเช็คชื่อพนักงาน</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- React & ReactDOM -->
    <script crossorigin src="https://unpkg.com/react@18/umd/react.development.js"></script>
    <script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.development.js"></script>
    
    <!-- Babel for JSX -->
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>

    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <style>
        /* Custom scrollbar for better look */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f1f1; 
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1; 
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8; 
        }
    </style>
</head>
<body class="bg-gray-50 text-gray-900 font-sans">
    <div id="root"></div>

    <script type="text/babel">
        const { useState, useEffect, useMemo } = React;

        // --- Mock Lucide Icons for standalone HTML ---
        // Since we can't easily import react components from unpkg lucide in babel standalone,
        // we use a simple wrapper component that creates an <i> tag which lucide script will replace.
        const Icon = ({ name, size = 24, className = '', color = 'currentColor' }) => {
            useEffect(() => {
                if (window.lucide) {
                    window.lucide.createIcons();
                }
            });
            return <i data-lucide={name} width={size} height={size} className={className} stroke={color} strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" fill="none"></i>;
        };

        const SettingsIcon = (props) => <Icon name="settings" {...props} />;
        const CalendarIcon = (props) => <Icon name="calendar" {...props} />;
        const SearchIcon = (props) => <Icon name="search" {...props} />;
        const DownloadIcon = (props) => <Icon name="download" {...props} />;
        const PlusIcon = (props) => <Icon name="plus" {...props} />;
        const Trash2Icon = (props) => <Icon name="trash-2" {...props} />;
        const XIcon = (props) => <Icon name="x" {...props} />;
        const ChevronLeftIcon = (props) => <Icon name="chevron-left" {...props} />;


        // --- ข้อมูลตั้งต้น (Initial State) ---
        const defaultClubs = [
            { id: '1', name: 'FRIEND CLUB', times: ['00:00', '01:00', '02:00', '03:00', '04:00', '05:00', '06:00', '07:00'] },
            { id: '2', name: 'FC CLUB', times: ['23:20', '01:20', '02:20', '03:20', '04:20', '05:20', '06:20'] },
            { id: '3', name: 'CF MAN CLUB', times: ['23:40', '01:40', '02:40', '03:40', '04:40', '05:40', '06:40'] },
        ];

        const defaultTags = [
            { id: 't1', label: 'ST', color: '#ffb3ba' },
            { id: 't2', label: 'CR', color: '#baffc9' },
            { id: 't3', label: 'SL', color: '#ffffba' },
        ];

        const defaultMarks = [
            { id: 'm1', label: '/', color: '#baffc9' },
            { id: 'm2', label: 'X', color: '#ffb3ba' },
            { id: 'm3', label: '2', color: '#bae1ff' },
        ];

        const initialEmployees = [
            { id: 'e1', no: '601', name: 'พีช', clubId: '3' },
            { id: 'e2', no: '603', name: 'เฟย์', clubId: '3' },
            { id: 'e3', no: '604', name: 'ตี้', clubId: '3' },
            { id: 'e4', no: '610', name: 'เจแอน', clubId: '3' },
            { id: 'e5', no: '101', name: 'อลิส', clubId: '1' },
        ];

        function App() {
            // --- States ---
            const [currentView, setCurrentView] = useState('attendance');
            const [activeClubId, setActiveClubId] = useState(defaultClubs[0].id);
            const [selectedDate, setSelectedDate] = useState(new Date().toISOString().split('T')[0]);
            const [searchQuery, setSearchQuery] = useState('');
            
            // Settings States
            const [clubs, setClubs] = useState(defaultClubs);
            const [tags, setTags] = useState(defaultTags);
            const [marks, setMarks] = useState(defaultMarks);
            const [employees, setEmployees] = useState(initialEmployees);
            
            // Attendance Data State
            const [attendanceRecords, setAttendanceRecords] = useState({});

            // Cell Edit Modal State
            const [cellEdit, setCellEdit] = useState(null); 

            // Initialize Lucide icons on mount and update
            useEffect(() => {
                if (window.lucide) {
                    window.lucide.createIcons();
                }
            });

            // --- Helper Functions ---
            const getDailyRecord = (empId) => {
                return attendanceRecords[selectedDate]?.[empId] || { times: {}, tag: '', customTag: '', note: '' };
            };

            const updateDailyRecord = (empId, field, value) => {
                setAttendanceRecords(prev => ({
                ...prev,
                [selectedDate]: {
                    ...(prev[selectedDate] || {}),
                    [empId]: {
                    ...(prev[selectedDate]?.[empId] || { times: {}, tag: '', customTag: '', note: '' }),
                    [field]: value
                    }
                }
                }));
            };

            const updateTimeRecord = (empId, time, value) => {
                setAttendanceRecords(prev => {
                const dateRecords = prev[selectedDate] || {};
                const empRecord = dateRecords[empId] || { times: {}, tag: '', customTag: '', note: '' };
                return {
                    ...prev,
                    [selectedDate]: {
                    ...dateRecords,
                    [empId]: {
                        ...empRecord,
                        times: {
                        ...empRecord.times,
                        [time]: value
                        }
                    }
                    }
                };
                });
            };

            const exportToCSV = () => {
                const activeClub = clubs.find(c => c.id === activeClubId);
                const clubEmployees = employees.filter(e => e.clubId === activeClubId);
                
                let csvContent = "data:text/csv;charset=utf-8,\uFEFF"; 
                
                const headers = ['No.', 'Tag', 'Name', ...activeClub.times, 'Note'];
                csvContent += headers.join(',') + '\n';
                
                clubEmployees.forEach(emp => {
                const record = getDailyRecord(emp.id);
                const tagDisplay = record.customTag || (tags.find(t => t.id === record.tag)?.label) || '';
                
                const row = [
                    emp.no,
                    `"${tagDisplay}"`,
                    `"${emp.name}"`,
                    ...activeClub.times.map(time => {
                    const markVal = record.times[time];
                    const markDef = marks.find(m => m.id === markVal);
                    return `"${markDef ? markDef.label : (markVal || '')}"`;
                    }),
                    `"${record.note || ''}"`
                ];
                csvContent += row.join(',') + '\n';
                });

                const encodedUri = encodeURI(csvContent);
                const link = document.createElement("a");
                link.setAttribute("href", encodedUri);
                link.setAttribute("download", `เช็คชื่อ_${activeClub.name}_${selectedDate}.csv`);
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            };

            // --- Derived Data ---
            const filteredEmployees = useMemo(() => {
                return employees
                .filter(e => e.clubId === activeClubId)
                .filter(e => 
                    e.name.toLowerCase().includes(searchQuery.toLowerCase()) || 
                    e.no.includes(searchQuery)
                )
                .sort((a, b) => a.no.localeCompare(b.no));
            }, [employees, activeClubId, searchQuery]);

            const activeClub = clubs.find(c => c.id === activeClubId);

            const CellEditor = () => {
                if (!cellEdit) return null;
                const [customVal, setCustomVal] = useState(cellEdit.currentValue || '');

                const handleSave = (val) => {
                if (cellEdit.type === 'time') {
                    updateTimeRecord(cellEdit.empId, cellEdit.time, val);
                } else if (cellEdit.type === 'tag') {
                    if (val.startsWith('custom:')) {
                    updateDailyRecord(cellEdit.empId, 'customTag', val.split(':')[1]);
                    updateDailyRecord(cellEdit.empId, 'tag', 'custom');
                    } else {
                    updateDailyRecord(cellEdit.empId, 'tag', val);
                    updateDailyRecord(cellEdit.empId, 'customTag', '');
                    }
                } else if (cellEdit.type === 'note') {
                    updateDailyRecord(cellEdit.empId, 'note', val);
                }
                setCellEdit(null);
                };

                return (
                <div className="fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4">
                    <div className="bg-white rounded-xl shadow-xl w-full max-w-sm overflow-hidden">
                    <div className="p-4 border-b bg-gray-50 flex justify-between items-center">
                        <h3 className="font-bold text-lg text-gray-800">
                        {cellEdit.type === 'time' ? `เวลา ${cellEdit.time}` : cellEdit.type === 'tag' ? 'ป้ายกำกับ (Tag)' : 'หมายเหตุ'}
                        </h3>
                        <button onClick={() => setCellEdit(null)} className="p-1 hover:bg-gray-200 rounded-full"><XIcon size={20}/></button>
                    </div>
                    <div className="p-4 space-y-4">
                        
                        {cellEdit.type === 'time' && (
                        <React.Fragment>
                            <div className="grid grid-cols-3 gap-2">
                            {marks.map(m => (
                                <button
                                key={m.id}
                                onClick={() => handleSave(m.id)}
                                className="py-3 rounded-lg border border-gray-300 shadow-sm hover:opacity-80 font-bold text-lg text-gray-800"
                                style={{ backgroundColor: m.color }}
                                >
                                {m.label}
                                </button>
                            ))}
                            <button
                                onClick={() => handleSave('')}
                                className="py-3 rounded-lg border hover:bg-gray-50 text-gray-400 font-medium col-span-3"
                            >
                                ลบข้อมูล (ว่าง)
                            </button>
                            </div>
                            <div>
                            <label className="block text-sm text-gray-600 mb-1">อื่นๆ (พิมพ์เอง)</label>
                            <div className="flex gap-2">
                                <input 
                                type="text" 
                                value={customVal} 
                                onChange={e=>setCustomVal(e.target.value)}
                                className="flex-1 border rounded-lg px-3 py-2"
                                placeholder="เช่น ลาป่วย, สาย..."
                                />
                                <button onClick={() => handleSave(customVal)} className="bg-blue-600 text-white px-4 rounded-lg">บันทึก</button>
                            </div>
                            </div>
                        </React.Fragment>
                        )}

                        {cellEdit.type === 'tag' && (
                        <React.Fragment>
                            <div className="grid grid-cols-2 gap-2">
                            {tags.map(t => (
                                <button
                                key={t.id}
                                onClick={() => handleSave(t.id)}
                                className="py-3 rounded-lg border font-bold text-gray-800 shadow-sm hover:opacity-80 border-gray-300"
                                style={{ backgroundColor: t.color }}
                                >
                                {t.label}
                                </button>
                            ))}
                            <button
                                onClick={() => handleSave('')}
                                className="py-3 rounded-lg border hover:bg-gray-50 text-gray-400 font-medium col-span-2"
                            >
                                ลบ Tag
                            </button>
                            </div>
                            <div>
                            <label className="block text-sm text-gray-600 mb-1">อื่นๆ (พิมพ์ Tag เอง)</label>
                            <div className="flex gap-2">
                                <input 
                                type="text" 
                                value={customVal} 
                                onChange={e=>setCustomVal(e.target.value)}
                                className="flex-1 border rounded-lg px-3 py-2"
                                placeholder="เช่น OT"
                                />
                                <button onClick={() => handleSave(`custom:${customVal}`)} className="bg-blue-600 text-white px-4 rounded-lg">บันทึก</button>
                            </div>
                            </div>
                        </React.Fragment>
                        )}

                        {cellEdit.type === 'note' && (
                        <div>
                            <textarea 
                            value={customVal} 
                            onChange={e=>setCustomVal(e.target.value)}
                            className="w-full border rounded-lg px-3 py-2 h-24 resize-none"
                            placeholder="เพิ่มหมายเหตุ..."
                            />
                            <div className="flex justify-end mt-2">
                            <button onClick={() => handleSave(customVal)} className="bg-blue-600 text-white px-4 py-2 rounded-lg">บันทึก</button>
                            </div>
                        </div>
                        )}

                    </div>
                    </div>
                </div>
                );
            };

            const SettingsView = () => {
                const [newTime, setNewTime] = useState('');

                const addClub = () => setClubs([...clubs, { id: Date.now().toString(), name: 'New Club', times: [] }]);
                const deleteClub = (id) => setClubs(clubs.filter(c => c.id !== id));
                const updateClub = (id, name) => setClubs(clubs.map(c => c.id === id ? { ...c, name } : c));
                
                const addTime = (clubId) => {
                if(!newTime) return;
                setClubs(clubs.map(c => c.id === clubId ? { ...c, times: [...c.times, newTime] } : c));
                setNewTime('');
                };
                const removeTime = (clubId, timeIndex) => {
                setClubs(clubs.map(c => c.id === clubId ? { ...c, times: c.times.filter((_, i) => i !== timeIndex) } : c));
                };

                return (
                <div className="max-w-4xl mx-auto p-4 space-y-8 pb-20">
                    <div className="flex items-center gap-4 border-b pb-4">
                    <button onClick={() => setCurrentView('attendance')} className="p-2 bg-gray-100 rounded-full hover:bg-gray-200">
                        <ChevronLeftIcon size={24} />
                    </button>
                    <h1 className="text-2xl font-bold text-gray-800">ตั้งค่าระบบ</h1>
                    </div>

                    {/* Clubs Settings */}
                    <section className="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
                    <h2 className="text-xl font-bold mb-4 text-gray-800 border-b pb-2">จัดการสาขา / คลับ และเวลาเช็คชื่อ</h2>
                    <div className="space-y-6">
                        {clubs.map(club => (
                        <div key={club.id} className="border rounded-lg p-4 bg-gray-50">
                            <div className="flex flex-wrap items-center gap-2 mb-4">
                            <input 
                                type="text" 
                                value={club.name}
                                onChange={(e) => updateClub(club.id, e.target.value)}
                                className="font-bold text-lg border-b bg-transparent border-gray-300 focus:border-blue-500 outline-none px-1 py-1"
                            />
                            <button onClick={() => deleteClub(club.id)} className="text-red-500 p-1 hover:bg-red-50 rounded"><Trash2Icon size={18}/></button>
                            </div>
                            
                            <div className="mb-2 text-sm text-gray-600 font-medium">ตารางเวลาเช็คชื่อ (จิ้มที่เวลาเพื่อลบ):</div>
                            <div className="flex flex-wrap gap-2 mb-3">
                            {club.times.map((t, i) => (
                                <button 
                                key={i} 
                                onClick={() => removeTime(club.id, i)}
                                className="px-3 py-1 bg-white border rounded-full text-sm hover:bg-red-50 hover:text-red-600 hover:border-red-200 flex items-center gap-1 group"
                                >
                                {t} <XIcon size={14} className="opacity-0 group-hover:opacity-100 transition-opacity" />
                                </button>
                            ))}
                            {club.times.length === 0 && <span className="text-sm text-gray-400 italic">ไม่มีเวลาที่ตั้งไว้</span>}
                            </div>
                            
                            <div className="flex gap-2 max-w-xs">
                            <input 
                                type="time" 
                                value={newTime}
                                onChange={(e) => setNewTime(e.target.value)}
                                className="border rounded px-2 py-1 text-sm flex-1" 
                            />
                            <button onClick={() => addTime(club.id)} className="bg-blue-600 text-white px-3 py-1 rounded text-sm hover:bg-blue-700">
                                เพิ่มเวลา
                            </button>
                            </div>
                        </div>
                        ))}
                        <button onClick={addClub} className="flex items-center gap-2 text-blue-600 hover:bg-blue-50 px-4 py-2 rounded-lg font-medium w-full justify-center border border-dashed border-blue-300">
                        <PlusIcon size={20} /> เพิ่มสาขา/คลับ
                        </button>
                    </div>
                    </section>

                    {/* Tags Settings */}
                    <section className="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
                    <h2 className="text-xl font-bold mb-4 text-gray-800 border-b pb-2">จัดการป้ายกำกับ (Tag ST, CR, SL...)</h2>
                    <div className="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
                        {tags.map((tag) => (
                        <div key={tag.id} className="flex items-center gap-2 border p-2 rounded-lg">
                            <input type="color" value={tag.color} onChange={e => setTags(tags.map(t => t.id === tag.id ? {...t, color: e.target.value} : t))} className="w-8 h-8 rounded cursor-pointer" />
                            <input type="text" value={tag.label} onChange={e => setTags(tags.map(t => t.id === tag.id ? {...t, label: e.target.value} : t))} className="flex-1 border outline-none px-2 py-1 rounded text-center font-bold text-gray-800" style={{ backgroundColor: tag.color }} />
                            <button onClick={() => setTags(tags.filter(t => t.id !== tag.id))} className="text-red-500 p-1"><Trash2Icon size={16}/></button>
                        </div>
                        ))}
                        <button onClick={() => setTags([...tags, { id: Date.now().toString(), label: 'New Tag', color: '#eeeeee' }])} className="flex items-center justify-center gap-2 border border-dashed p-2 rounded-lg text-gray-500 hover:bg-gray-50">
                        <PlusIcon size={18} /> เพิ่ม Tag
                        </button>
                    </div>
                    </section>

                    {/* Marks Settings */}
                    <section className="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
                    <h2 className="text-xl font-bold mb-4 text-gray-800 border-b pb-2">จัดการสัญลักษณ์เช็คชื่อ ( / , X , 2 )</h2>
                    <p className="text-sm text-gray-500 mb-4">กำหนดสัญลักษณ์และ <span className="font-bold">สีพื้นหลัง</span> เพื่อให้แสดงผลเป็นป้าย (Badge) ในตาราง</p>
                    <div className="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
                        {marks.map((mark) => (
                        <div key={mark.id} className="flex items-center gap-2 border p-2 rounded-lg">
                            <input type="color" value={mark.color} onChange={e => setMarks(marks.map(m => m.id === mark.id ? {...m, color: e.target.value} : m))} className="w-8 h-8 rounded cursor-pointer" />
                            <input type="text" value={mark.label} onChange={e => setMarks(marks.map(m => m.id === mark.id ? {...m, label: e.target.value} : m))} className="flex-1 border outline-none px-2 py-1 rounded text-center font-bold text-gray-800" style={{ backgroundColor: mark.color }} />
                            <button onClick={() => setMarks(marks.filter(m => m.id !== mark.id))} className="text-red-500 p-1"><Trash2Icon size={16}/></button>
                        </div>
                        ))}
                        <button onClick={() => setMarks([...marks, { id: Date.now().toString(), label: 'New', color: '#e5e7eb' }])} className="flex items-center justify-center gap-2 border border-dashed p-2 rounded-lg text-gray-500 hover:bg-gray-50">
                        <PlusIcon size={18} /> เพิ่มสัญลักษณ์
                        </button>
                    </div>
                    </section>

                    {/* Employees Settings */}
                    <section className="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
                    <h2 className="text-xl font-bold mb-4 text-gray-800 border-b pb-2">จัดการรายชื่อพนักงาน</h2>
                    <div className="overflow-x-auto">
                        <table className="w-full text-left border-collapse">
                        <thead>
                            <tr className="bg-gray-100 text-gray-700 text-sm">
                            <th className="p-2 border">รหัส (No.)</th>
                            <th className="p-2 border">ชื่อ</th>
                            <th className="p-2 border">สาขา/คลับ</th>
                            <th className="p-2 border text-center">ลบ</th>
                            </tr>
                        </thead>
                        <tbody>
                            {employees.map(emp => (
                            <tr key={emp.id} className="hover:bg-gray-50">
                                <td className="p-2 border">
                                <input type="text" value={emp.no} onChange={e => setEmployees(employees.map(em => em.id === emp.id ? {...em, no: e.target.value} : em))} className="w-full outline-none bg-transparent" />
                                </td>
                                <td className="p-2 border">
                                <input type="text" value={emp.name} onChange={e => setEmployees(employees.map(em => em.id === emp.id ? {...em, name: e.target.value} : em))} className="w-full outline-none bg-transparent" />
                                </td>
                                <td className="p-2 border">
                                <select value={emp.clubId} onChange={e => setEmployees(employees.map(em => em.id === emp.id ? {...em, clubId: e.target.value} : em))} className="w-full outline-none bg-transparent cursor-pointer">
                                    {clubs.map(c => <option key={c.id} value={c.id}>{c.name}</option>)}
                                </select>
                                </td>
                                <td className="p-2 border text-center">
                                <button onClick={() => setEmployees(employees.filter(em => em.id !== emp.id))} className="text-red-500 hover:bg-red-50 p-1 rounded"><Trash2Icon size={16}/></button>
                                </td>
                            </tr>
                            ))}
                        </tbody>
                        </table>
                    </div>
                    <button onClick={() => setEmployees([...employees, { id: Date.now().toString(), no: '', name: 'ชื่อใหม่', clubId: clubs[0]?.id || '' }])} className="mt-4 flex items-center justify-center gap-2 text-blue-600 hover:bg-blue-50 px-4 py-2 rounded-lg font-medium w-full border border-dashed border-blue-300">
                        <PlusIcon size={20} /> เพิ่มพนักงาน
                    </button>
                    </section>
                </div>
                );
            };

            const AttendanceView = () => {
                if (!activeClub) return <div className="p-8 text-center text-gray-500">กรุณาตั้งค่าคลับก่อนใช้งาน</div>;

                return (
                <div className="flex flex-col h-screen bg-gray-50">
                    {/* Top Action Bar */}
                    <div className="bg-white px-4 py-3 shadow-sm z-10 flex flex-wrap items-center justify-between gap-4">
                    
                    {/* Tabs for Clubs */}
                    <div className="flex gap-1 bg-gray-100 p-1 rounded-lg overflow-x-auto max-w-full">
                        {clubs.map(club => (
                        <button
                            key={club.id}
                            onClick={() => setActiveClubId(club.id)}
                            className={`px-4 py-2 rounded-md whitespace-nowrap text-sm font-bold transition-colors ${
                            activeClubId === club.id ? 'bg-white text-blue-600 shadow-sm' : 'text-gray-600 hover:bg-gray-200'
                            }`}
                        >
                            {club.name}
                        </button>
                        ))}
                    </div>

                    {/* Tools */}
                    <div className="flex items-center gap-3 flex-wrap">
                        <div className="flex items-center bg-gray-100 rounded-lg px-3 py-2 border focus-within:border-blue-500">
                        <CalendarIcon size={18} className="text-gray-500 mr-2" />
                        <input 
                            type="date" 
                            value={selectedDate} 
                            onChange={(e) => setSelectedDate(e.target.value)}
                            className="bg-transparent outline-none text-sm font-medium text-gray-700"
                        />
                        </div>

                        <div className="flex items-center bg-white rounded-lg px-3 py-2 border focus-within:border-blue-500 w-48">
                        <SearchIcon size={18} className="text-gray-400 mr-2" />
                        <input 
                            type="text" 
                            placeholder="ค้นหาชื่อ, รหัส..." 
                            value={searchQuery}
                            onChange={(e) => setSearchQuery(e.target.value)}
                            className="bg-transparent outline-none text-sm w-full"
                        />
                        </div>

                        <button onClick={exportToCSV} className="flex items-center gap-2 bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors shadow-sm">
                        <DownloadIcon size={16} /> Export (CSV)
                        </button>

                        <button onClick={() => setCurrentView('settings')} className="flex items-center gap-2 bg-gray-800 hover:bg-gray-900 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors shadow-sm ml-auto">
                        <SettingsIcon size={16} /> ตั้งค่า
                        </button>
                    </div>
                    </div>

                    {/* Main Table Area */}
                    <div className="flex-1 overflow-auto p-4">
                    <div className="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
                        <div className="overflow-x-auto relative">
                        <table className="w-full text-sm text-left border-collapse min-w-max">
                            <thead>
                            <tr className="bg-gray-800 text-white">
                                <th className="p-3 border-b border-gray-700 w-16 text-center sticky left-0 bg-gray-800 z-20">No.</th>
                                <th className="p-3 border-b border-gray-700 w-24 text-center sticky left-[64px] bg-gray-800 z-20">Tag</th>
                                <th className="p-3 border-b border-gray-700 w-48 sticky left-[160px] bg-gray-800 z-20">ชื่อพนักงาน</th>
                                {activeClub.times.map((time, idx) => (
                                <th key={idx} className="p-3 border-b border-gray-700 text-center min-w-[60px] border-l border-gray-700">
                                    {time}
                                </th>
                                ))}
                                <th className="p-3 border-b border-gray-700 w-48 border-l border-gray-700">หมายเหตุ</th>
                            </tr>
                            </thead>
                            <tbody>
                            {filteredEmployees.length === 0 ? (
                                <tr>
                                <td colSpan={activeClub.times.length + 4} className="p-8 text-center text-gray-500">
                                    ไม่พบรายชื่อพนักงานในคลับนี้ หรือไม่พบข้อมูลที่ค้นหา
                                </td>
                                </tr>
                            ) : (
                                filteredEmployees.map((emp, index) => {
                                const record = getDailyRecord(emp.id);
                                
                                // Resolve Tag styling
                                let tagObj = null;
                                let tagLabel = '';
                                if (record.tag === 'custom') {
                                    tagLabel = record.customTag;
                                    tagObj = { color: '#f3f4f6' }; // bg-gray-100 for custom
                                } else if (record.tag) {
                                    tagObj = tags.find(t => t.id === record.tag);
                                    if(tagObj) tagLabel = tagObj.label;
                                }

                                return (
                                    <tr key={emp.id} className="hover:bg-blue-50 border-b border-gray-100 transition-colors group">
                                    {/* No. */}
                                    <td className="p-2 border-r text-center font-medium text-gray-500 sticky left-0 bg-white z-10 group-hover:bg-blue-50">
                                        {emp.no}
                                    </td>
                                    
                                    {/* Tag (Left Side) */}
                                    <td 
                                        className="p-2 border-r text-center cursor-pointer sticky left-[64px] bg-white z-10 group-hover:bg-blue-50"
                                        onClick={() => setCellEdit({ empId: emp.id, type: 'tag', currentValue: record.tag === 'custom' ? `custom:${record.customTag}` : record.tag })}
                                    >
                                        <div 
                                        className={`mx-auto w-full max-w-[60px] py-1 rounded text-xs font-bold ${!tagLabel ? 'border border-dashed border-gray-300 text-gray-300 hover:border-gray-400' : 'text-gray-800 border border-gray-300 shadow-sm'}`}
                                        style={{ backgroundColor: tagObj ? tagObj.color : 'transparent' }}
                                        >
                                        {tagLabel || '+ Tag'}
                                        </div>
                                    </td>

                                    {/* Name */}
                                    <td className="p-3 border-r font-bold text-gray-800 sticky left-[160px] bg-white z-10 group-hover:bg-blue-50">
                                        {emp.name}
                                    </td>

                                    {/* Times Columns (Now styled like tags) */}
                                    {activeClub.times.map((time) => {
                                        const val = record.times[time];
                                        let display = '';
                                        let bgColor = 'transparent';
                                        let hasBorder = false;
                                        
                                        const markObj = marks.find(m => m.id === val);
                                        if (markObj) {
                                        display = markObj.label;
                                        bgColor = markObj.color;
                                        hasBorder = true;
                                        } else if (val) {
                                        display = val; // Custom text
                                        bgColor = '#f3f4f6'; // Light gray for custom text
                                        hasBorder = true;
                                        }

                                        return (
                                        <td 
                                            key={time} 
                                            className="p-0 border-r border-gray-200 text-center cursor-pointer hover:bg-blue-100 transition-colors"
                                            onClick={() => setCellEdit({ empId: emp.id, time: time, type: 'time', currentValue: val })}
                                        >
                                            <div className="w-full h-12 flex items-center justify-center">
                                            {display && (
                                                <div 
                                                className={`px-2 py-1 min-w-[28px] text-center rounded text-sm font-bold text-gray-800 ${hasBorder ? 'border border-gray-300 shadow-sm' : ''}`}
                                                style={{ backgroundColor: bgColor }}
                                                >
                                                {display}
                                                </div>
                                            )}
                                            </div>
                                        </td>
                                        );
                                    })}

                                    {/* Remark */}
                                    <td 
                                        className="p-2 cursor-pointer hover:bg-blue-100 transition-colors border-l border-gray-200"
                                        onClick={() => setCellEdit({ empId: emp.id, type: 'note', currentValue: record.note })}
                                    >
                                        <div className="w-full min-h-[2rem] text-sm text-gray-600 whitespace-pre-wrap flex items-center">
                                        {record.note || <span className="text-gray-300 italic text-xs">คลิกเพื่อเพิ่มหมายเหตุ...</span>}
                                        </div>
                                    </td>
                                    </tr>
                                );
                                })
                            )}
                            </tbody>
                        </table>
                        </div>
                    </div>
                    </div>
                </div>
                );
            };

            return (
                <div className="font-sans text-gray-900 bg-gray-50 min-h-screen selection:bg-blue-200">
                {currentView === 'attendance' ? <AttendanceView /> : <SettingsView />}
                <CellEditor />
                </div>
            );
        }

        // Render the app
        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>
</html>
